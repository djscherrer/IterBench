{
  "packages": [
    "python@3.12",
    "uv",
    "nodejs@22",
    "go@1.23",
    "rustc@1.83.0",
    "cargo@1.83.0",
    "gcc",
    "sqlite"
  ],
  "env": {
    "CGO_ENABLED": "1"
  },
  "shell": {
    "init_hook": [
      "echo 'Installing Python packages with uv...'",
      "uv sync"
    ],
    "scripts": {
      "install": "uv sync",
      "test": "uv run python src/main.py --mode test @config.args",
      "generate": "uv run python src/main.py --mode generate @config.args"
    }
  }
}
